# ---- Model provider: pick ONE ----------------------------------------------
# Free: Google Gemini (key from https://aistudio.google.com/apikey)
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Paid: Anthropic Claude
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Any other OpenAI-compatible endpoint (OpenRouter, Ollama, vLLM...)
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# WORKER_MODEL=qwen3:32b

# ---- Optional tuning (defaults shown) --------------------------------------
# WORKER_MODEL=                 # default: gemini-3.8-flash / claude-opus-5-5
# LLM_RPM=5                     # requests/minute cap (Gemini free tier default 5; 0 = no cap)
# WORKER_EFFORT=medium          # low | medium | high
# VERIFIER_EFFORT=medium
# WORKER_MAX_TURNS=60
# VERIFIER_MAX_TURNS=25
# MAX_REPAIR_ROUNDS=2
# HEADLESS=true                 # false = watch the browser drive the apps (good for demos)
# USE_REFUSAL_FALLBACKS=true    # Claude only
# SIM_TODAY=2026-10-12          # pinned "today" shared by the sim apps and the agent
